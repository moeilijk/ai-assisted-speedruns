# OBS recorder (obs-websocket v5; password from OBS → Tools → WebSocket Server Settings)
AAS_OBS_URL=ws://127.0.0.1:4455
AAS_OBS_PASSWORD=
# Portal: the Source Unpack folder (where portal/agent_runs/ is), as a WSL path
AAS_PORTAL_GAME_ROOT=
# Slay the Spire (Steam 646570 + Workshop ModTheSpire 1605060445 and BaseMod 1605833019; npm run sts:install adds Communication Mod)
AAS_STS_GAME_ROOT=/mnt/c/Program Files (x86)/Steam/steamapps/common/SlayTheSpire
# AAS_STS_CLASS=IRONCLAD  AAS_STS_ASCENSION=0  AAS_STS_PORT=27183
# Reference seed for the Ironclad act3 category: chosen on measured winnability (70% of whole-run playouts won
# against 6% for a random seed, games/slay-the-spire/seed-criteria.md). Empty = a random seed, in summary.json.
AAS_STS_SEED=23M
# Share of the weekly Claude plan that runs may use (aas budget); the rest stays for other work
AAS_BUDGET_WEEKLY_MAX=50
# Share of the ChatGPT plan's window (as Codex last recorded it in its rollouts) that Codex runs may use
AAS_CODEX_BUDGET_MAX=50

# Optional, per machine. Everything below is OFF when unset: the game starts where Windows puts
# it, plays on the default audio device, and the displays follow the power settings.
# Move the game window (X,Y), e.g. onto a secondary display so the run stays off your desktop:
# AAS_PORTAL_WINDOW_POS=   AAS_PORTAL_RESOLUTION=1920x1080   AAS_STS_WINDOW_POS=   AAS_LIVESPLIT_POS=
# Keep game audio off the speakers: the Windows default playback device is switched to this device
# only while the game starts (NirSoft SoundVolumeView does the switch), then restored.
# AAS_QUIET_AUDIO_DEVICE=   AAS_SOUNDVOLUMEVIEW=/path/to/SoundVolumeView.exe
# Keep the displays awake during a run (needed when the quiet device is a display's HDMI audio):
# AAS_KEEP_DISPLAYS_AWAKE=1
# Where install-mod puts the bridge copy for Slay the Spire (default <game>/aas): AAS_STS_TOOLS_DIR=
# Scripted bot (games/slay-the-spire/bot.mjs): combat oracle = gamerpuppy/sts_lightspeed's test binary (clone into .local, build the
# test target with g++ -std=c++17); without it the bot uses its own turn planner. AAS_BOT_TAPE replays a recorded run first.
# AAS_BOT_ORACLE=.local/sts_lightspeed/build/test   AAS_BOT_ORACLE_SIMS=200000   AAS_BOT_TAPE=
