+void Deck::transformRandomCards(GameContext &gc, Random &rng, int count) {
+    // Was empty, so the Designer's "transform two cards" changed nothing at all while the game swapped two cards
+    // out of the deck. Built like upgradeRandomCards above it: collect what may be transformed, shuffle that list
+    // and take the first ones. and take the first ones, the way upgradeRandomCards does it for this same event's upgrade option.
+    fixed_list<int, Deck::MAX_SIZE> list;
+    for (int i = 0; i < cards.size(); ++i) {
+        if (cards[i].canTransform() && !isCardBottled(i)) {
+            list.push_back(i);
+        }
+    }
+    java::Collections::shuffle(list.begin(), list.end(), java::Random(rng.randomLong()));
+    const int end = std::min(static_cast<int>(list.size()), count);
+
+    fixed_list<CardId, Deck::MAX_SIZE> toObtain;
+    fixed_list<int, Deck::MAX_SIZE> toRemove;
+    for (int i = 0; i < end; ++i) {
+        toObtain.push_back(cards[list[i]].getId());
+        toRemove.push_back(list[i]);
+    }
+    std::sort(toRemove.begin(), toRemove.end(), std::greater<int>());
+    for (const int idx : toRemove) {
+        remove(gc, idx);
+    }
+    for (const CardId id : toObtain) {
+        obtain(gc, gc.getTransformedCard(rng, id));
+    }
