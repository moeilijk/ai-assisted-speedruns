+void BattleContext::chooseScryCards(const fixed_list<int,10> &idxs) {
+    // The indices count from the top of the draw pile, which is the back of the list because drawing takes
+    // drawPile.back(). Everything picked goes to the discard pile; the rest stays in place.
+    if (idxs.empty()) {
+        return;
+    }
+    auto listCopy = idxs;
+    std::sort(listCopy.begin(), listCopy.end(), [](auto a, auto b) { return a < b; });
+    for (int i = static_cast<int>(listCopy.size()) - 1; i >= 0; --i) {
+        const int fromTop = listCopy[i];
+        const int idx = static_cast<int>(cards.drawPile.size()) - 1 - fromTop;
+        if (idx < 0 || idx >= static_cast<int>(cards.drawPile.size())) {
+            continue;
+        }
+        auto c = cards.drawPile[idx];
+        cards.drawPile.erase(cards.drawPile.begin() + idx);
+        cards.moveToDiscardPile(c);
+    }
+}
+
+void BattleContext::chooseForethoughtCards(const fixed_list<int,10> &idxs) {
+    // Upgraded Forethought puts any number of cards on the bottom of the draw pile. The cards are taken from the
+    // hand highest index first so the earlier indices stay valid, and each one goes to the bottom in turn, which
+    // is the order the game ends up with.
+    if (idxs.empty()) {
+        return;
+    }
+    auto listCopy = idxs;
+    std::sort(listCopy.begin(), listCopy.end(), [](auto a, auto b) { return b < a; });
+    for (const auto handIdx : listCopy) {
+        chooseForethoughtCard(handIdx);
+    }
+}
