+// aas: the event choices are measured, not guessed. AAS_EVENT_PREFS carries them as
+// "Mushrooms:1|0,Colosseum:1|0" -- the event's own name, then the options in order of preference. The first one
+// the simulator actually offers is taken; an event that is not named keeps the behaviour below.
+static const std::map<std::string, std::vector<int>> &aasEventPrefs() {
+    static const std::map<std::string, std::vector<int>> prefs = [] {
+        std::map<std::string, std::vector<int>> m;
+        const char *env = std::getenv("AAS_EVENT_PREFS");
+        if (env == nullptr) return m;
+        std::string s(env), name;
+        std::vector<int> list;
+        std::size_t i = 0;
+        while (i <= s.size()) {
+            const char c = i < s.size() ? s[i] : ',';
+            if (c == ':') { name = s.substr(0, i); s = s.substr(i + 1); i = 0; continue; }
+            if (c == '|' || c == ',') {
+                if (i > 0) list.push_back(std::atoi(s.substr(0, i).c_str()));
+                s = s.substr(std::min(i + 1, s.size()));
+                i = 0;
+                if (c == ',' || s.empty()) { if (!name.empty()) m[name] = list; name.clear(); list.clear(); }
+                if (s.empty()) break;
+                continue;
+            }
+            ++i;
+        }
+        return m;
+    }();
+    return prefs;
+}
+
 void search::ScumSearchAgent2::stepEventPolicy(GameContext &gc) {
+    const int validBits = search::GameAction::getValidEventSelectBits(gc);
+    auto choose = [&](const std::vector<int> &prefs) {
+        for (int o : prefs) if (validBits & (1 << o)) { takeAction(gc, o); return true; }
+        return false;
+    };
+    const auto &prefs = aasEventPrefs();
+    const auto it = prefs.find(eventGameNames[static_cast<int>(gc.curEvent)]);
+    if (it != prefs.end() && choose(it->second)) return;
+
     switch (gc.curEvent) {
 
         case Event::NEOW:
